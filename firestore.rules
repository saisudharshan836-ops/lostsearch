rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{reportId} {
      // Any signed-in user (the app uses Firebase Anonymous Authentication)
      // can view campus reports.
      allow read: if request.auth != null;

      // New reports must be created by a signed-in user and carry that user's UID.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'type','name','category','location','date','description',
          'reporter','contact','resolved','createdAt','ownerUid'
        ])
        && request.resource.data.type in ['lost','found']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.resolved == false;

      // Only the author of a report may mark it reunited or delete it.
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
